<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="6dp"
    android:background="@drawable/bmray_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">
    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/bmray_widget_connect"
        android:src="@drawable/ic_bmray_tile" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BMray"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/bmray_tile_disconnected"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bmray_widget_action_background"
        android:maxLines="1"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:text="@string/bmray_widget_connect"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
