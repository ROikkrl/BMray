<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/bmray_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">
    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:contentDescription="@string/bmray_widget_connect"
        android:src="@drawable/ic_bmray_tile" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BMray"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/bmray_tile_disconnected"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/bmray_widget_action_background"
        android:maxLines="1"
        android:paddingLeft="5dp"
        android:paddingTop="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp"
        android:text="@string/bmray_widget_connect"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
